# Copy to .env and fill in. `.env` is gitignored.
#
# Everything here is set up for a laptop. For anything reachable by other people
# see DEPLOYMENT.md -- in short, set BACKEND_ENV=production and ENGINE_ENV=
# production, which makes both services refuse to start on a default that is
# only safe locally, rather than serve with one.

# --- AI engine service ------------------------------------------------------
# Optional shared secret. When set, the engine requires a matching X-API-Key on
# every route except /health and /health/ready, and the backend must send the same
# value below.
# Leave both blank on localhost.
ENGINE_API_KEY=

# `local` (default) or `production`. In production the engine will not start
# without a key set -- it holds your provider credentials and has no notion of
# end users, so it must never be openly reachable.
# ENGINE_ENV=local

# Named keys, `name:secret` separated by commas. Prefer these over the single
# ENGINE_API_KEY above for anything real: the name is logged and is what rate
# limits are counted against, so one misbehaving caller can be found and cut off
# without disturbing the others -- and you can rotate by running the old and new
# key side by side instead of restarting every caller at once.
# ENGINE_API_KEYS=web:s3cret,batch:0ther

# Per-caller rate limits. The engine is where provider credits are actually
# spent, so it meters as well as whatever calls it. Zero disables.
# ENGINE_CHAT_RATE_LIMIT_PER_MINUTE=60
# ENGINE_EVAL_RATE_LIMIT_PER_HOUR=20
# ENGINE_INGEST_RATE_LIMIT_PER_MINUTE=20

# Where the buckets live. Unset, in this process; several replicas then each
# grant the full allowance. A Redis URL makes every replica share one bucket
# per caller. See DEPLOYMENT.md, "Scaling out".
# ENGINE_REDIS_URL=redis://localhost:6379/0

# Your OpenRouter key. Without it the engine starts, records and chunks
# documents, and answers 501 to anything that needs a model.
ENGINE_OPENROUTER_API_KEY=

# Prices per million tokens, {model: [input, output]} in USD, from
# https://openrouter.ai/models. The engine ships none: a model not listed shows
# no cost rather than a stale one. These are the demo's three models.
ENGINE_PRICING={"openai/gpt-5-mini": [0.25, 2.00], "anthropic/claude-haiku-4.5": [1.00, 5.00], "google/gemini-2.5-flash": [0.30, 2.50]}

# Everything below is optional -- the defaults live in engine settings.py.
# ENGINE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Transient provider failures are retried with backoff; a hung provider is
# given up on after the timeout.
# ENGINE_PROVIDER_MAX_RETRIES=3
# ENGINE_PROVIDER_TIMEOUT_S=60
# How long a tool server's tool list is reused before it is asked again.
# ENGINE_MCP_TOOLS_TTL_S=60
# `text` for a terminal, `json` for a log collector. Every line carries the
# request id either way. GET /metrics is on unless disabled.
# ENGINE_LOG_FORMAT=text
# ENGINE_METRICS_ENABLED=true
# Tracing of every model call: off | langsmith | langfuse. Langfuse can be
# self-hosted; set its host accordingly. Both record the request, project,
# session and user ids on every trace.
# ENGINE_TRACING=off
# ENGINE_LANGSMITH_API_KEY=
# ENGINE_LANGSMITH_PROJECT=chatbot-engine
# ENGINE_LANGFUSE_PUBLIC_KEY=
# ENGINE_LANGFUSE_SECRET_KEY=
# ENGINE_LANGFUSE_HOST=https://cloud.langfuse.com
# ENGINE_CHAT_MODEL=openai/gpt-5-mini
# A cheaper model for the query rewrite and the rerank; unset uses the
# assistant's own model.
# ENGINE_UTILITY_MODEL=openai/gpt-5-nano
# The model that scores /eval/rag. Keep it cheap and in another family than
# the chat model, so answers are not graded by their own author.
# ENGINE_RAG_JUDGE_MODEL=google/gemini-2.5-flash-lite
# ENGINE_EMBEDDING_MODEL=openai/text-embedding-3-small
# ENGINE_AGENT=loop                   # loop, or the name of an installed plugin
# ENGINE_RETRIEVAL=hybrid             # vector | hybrid (vector + keyword search)
# ENGINE_RERANK=false                 # the model re-orders candidates; one extra call
# ENGINE_RETRIEVAL_CANDIDATES=20
# ENGINE_CHUNK_STRATEGY=size          # size | headings | page
# ENGINE_CHUNK_SIZE=1000
# ENGINE_CHUNK_OVERLAP=200
# ENGINE_CHROMA_DIR=var/chroma
# ENGINE_CHROMA_COLLECTION=documents
# A Chroma server instead of the embedded files, so replicas can share it.
# ENGINE_CHROMA_URL=http://localhost:8000
# ENGINE_CHROMA_TOKEN=                # its credential, sent as a bearer token
# ENGINE_CHROMA_TOKEN_HEADER=Authorization   # or X-Chroma-Token
# The document registry in Postgres, and the stored originals in a bucket,
# instead of the SQLite file and the directory, so replicas share both.
# ENGINE_REGISTRY_URL=postgresql://user:pass@localhost:5432/chatbot_engine
# ENGINE_BLOB_S3_BUCKET=chatbot-engine
# ENGINE_BLOB_S3_ENDPOINT_URL=http://localhost:9000   # MinIO; unset for AWS
# ENGINE_BLOB_S3_REGION=us-east-1
# ENGINE_BLOB_S3_PREFIX=
# ENGINE_REGISTRY_DB=var/documents.sqlite3
# ENGINE_BLOB_DIR=var/blobs

# --- application backend ----------------------------------------------------
# Where the engine lives. Under Docker Compose this becomes http://engine:8100.
BACKEND_ENGINE_URL=http://localhost:8100
BACKEND_ENGINE_API_KEY=

BACKEND_DATABASE_URL=postgresql+psycopg://support_agent:support_agent@localhost:5432/support_agent

# Shared operator secret for the /admin routes -- the bookings and tickets views
# and the eval runs, which spend model credits. When set, the backend requires a
# matching X-Admin-Key and the dashboard asks for it once per browser tab.
# Leave blank on localhost; set it in any deployment.
BACKEND_ADMIN_KEY=

# `local` (default) or `production`. In production the backend refuses to start
# while BACKEND_ADMIN_KEY or BACKEND_ENGINE_API_KEY is unset, or the database
# still carries the demo password.
# BACKEND_ENV=local

# Believe the caller's X-User-Id header. Only ever true when a proxy in front
# authenticates the user and overwrites the header itself -- a browser can send
# any value, so trusting it on the open internet lets every caller claim to be
# every user. Off, every caller is `anonymous`.
# Handy locally for exercising per-user behaviour: turn it on and you can
# impersonate anyone with a header, which is exactly why it stays off by default.
# BACKEND_TRUST_USER_HEADER=false

# Per-caller rate limits. Every chat turn and every eval case is a model call
# on your provider key. Zero disables a limit. A Redis URL makes replicas share
# one bucket per caller, as for the engine.
# BACKEND_CHAT_RATE_LIMIT_PER_MINUTE=30
# BACKEND_EVAL_RATE_LIMIT_PER_HOUR=20
# BACKEND_REDIS_URL=redis://localhost:6379/1
# BACKEND_LOG_FORMAT=text

# Where the engine should dial this backend's MCP tool server.
# Under Docker Compose this becomes http://mcp-tools:8200/mcp.
BACKEND_MCP_TOOLS_URL=http://localhost:8200/mcp
