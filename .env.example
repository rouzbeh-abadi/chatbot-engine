# Copy to .env and fill in. `.env` is gitignored.
#
# Everything here is set up for a laptop. For anything reachable by other people
# see DEPLOYMENT.md -- in short, set BACKEND_ENV=production and ENGINE_ENV=
# production, which makes both services refuse to start on a default that is
# only safe locally, rather than serve with one.

# --- AI engine service ------------------------------------------------------
# Optional shared secret. When set, the engine requires a matching X-API-Key on
# every route except /health and /health/ready, and the backend must send the same
# value below.
# Leave both blank on localhost.
ENGINE_API_KEY=

# `local` (default) or `production`. In production the engine will not start
# without a key set -- it holds your provider credentials and has no notion of
# end users, so it must never be openly reachable.
# ENGINE_ENV=local

# Named keys, `name:secret` separated by commas. Prefer these over the single
# ENGINE_API_KEY above for anything real: the name is logged and is what rate
# limits are counted against, so one misbehaving caller can be found and cut off
# without disturbing the others -- and you can rotate by running the old and new
# key side by side instead of restarting every caller at once.
# ENGINE_API_KEYS=web:s3cret,batch:0ther

# Per-caller rate limits, in this process. The engine is where provider credits
# are actually spent, so it meters as well as whatever calls it. Zero disables.
# ENGINE_CHAT_RATE_LIMIT_PER_MINUTE=60
# ENGINE_EVAL_RATE_LIMIT_PER_HOUR=20
# ENGINE_INGEST_RATE_LIMIT_PER_MINUTE=20

# Your OpenRouter key. Prefixed for the engine, so it is readable the moment you
# add an `openrouter_api_key` field to chatbot_engine.settings.Settings.
ENGINE_OPENROUTER_API_KEY=

# Everything below is optional -- the defaults live in engine settings.py.
# ENGINE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ENGINE_CHAT_MODEL=openai/gpt-5-mini
# ENGINE_EMBEDDING_MODEL=openai/text-embedding-3-small
# ENGINE_CHUNK_SIZE=1000
# ENGINE_CHUNK_OVERLAP=200
# ENGINE_CHROMA_DIR=var/chroma
# ENGINE_CHROMA_COLLECTION=documents
# ENGINE_REGISTRY_DB=var/documents.sqlite3
# ENGINE_BLOB_DIR=var/blobs

# --- application backend ----------------------------------------------------
# Where the engine lives. Under Docker Compose this becomes http://engine:8100.
BACKEND_ENGINE_URL=http://localhost:8100
BACKEND_ENGINE_API_KEY=

BACKEND_DATABASE_URL=postgresql+psycopg://support_agent:support_agent@localhost:5432/support_agent

# Shared operator secret for the /admin routes -- the bookings and tickets views
# and the eval runs, which spend model credits. When set, the backend requires a
# matching X-Admin-Key and the dashboard asks for it once per browser tab.
# Leave blank on localhost; set it in any deployment.
BACKEND_ADMIN_KEY=

# `local` (default) or `production`. In production the backend refuses to start
# while BACKEND_ADMIN_KEY or BACKEND_ENGINE_API_KEY is unset, or the database
# still carries the demo password.
# BACKEND_ENV=local

# Believe the caller's X-User-Id header. Only ever true when a proxy in front
# authenticates the user and overwrites the header itself -- a browser can send
# any value, so trusting it on the open internet lets every caller claim to be
# every user. Off, every caller is `anonymous`.
# Handy locally for exercising per-user behaviour: turn it on and you can
# impersonate anyone with a header, which is exactly why it stays off by default.
# BACKEND_TRUST_USER_HEADER=false

# Per-caller rate limits, in this process. Every chat turn and every eval case
# is a model call on your provider key. Zero disables a limit.
# BACKEND_CHAT_RATE_LIMIT_PER_MINUTE=30
# BACKEND_EVAL_RATE_LIMIT_PER_HOUR=20

# Where the engine should dial this backend's MCP tool server.
# Under Docker Compose this becomes http://mcp-tools:8200/mcp.
BACKEND_MCP_TOOLS_URL=http://localhost:8200/mcp
